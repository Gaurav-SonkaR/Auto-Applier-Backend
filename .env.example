# ══════════════════════════════════════════════════════════════════════════════
# AutoApply AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Groq API key — free at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# HuggingFace Inference API token — fallback when Groq is rate-limited
# Get free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your_token_here

# ── Job Discovery ──────────────────────────────────────────────────────────────
# Serper.dev Google Search API — 100 free calls/day at https://serper.dev
SERPER_API_KEY=your_serper_key_here
DAILY_SEARCH_LIMIT=100
DISCOVERY_RECENCY_DAYS=2

# ── Application Settings ───────────────────────────────────────────────────────
DAILY_APPLY_LIMIT=50
SCRAPE_BATCH_SIZE=10
APPLY_BATCH_SIZE=3
SELENIUM_HEADLESS=true
SELENIUM_MAX_DRIVERS=2
# Optional; leave blank for Selenium Manager to locate Chrome/Chromium.
CHROME_BINARY=
HUMAN_DELAY_MIN_MS=800
HUMAN_DELAY_MAX_MS=2500

# ── Portal Credentials ─────────────────────────────────────────────────────────
# Gmail — used for portal login (Google OAuth) and cold email SMTP
# Use App Password, NOT your regular Gmail password.
# Setup: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Per-portal login credentials. {PORTAL}_EMAIL falls back to GMAIL_ADDRESS if left
# blank (fine when the portal uses Google sign-in with the same address). A blank
# password means the portal is skipped for auto-apply and its jobs are flagged for
# manual login — the tool never guesses or reuses your Gmail password to log in.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=your_linkedin_password
NAUKRI_EMAIL=
NAUKRI_PASSWORD=your_naukri_password
CUTSHORT_EMAIL=
CUTSHORT_PASSWORD=your_cutshort_password
WELLFOUND_EMAIL=
WELLFOUND_PASSWORD=your_wellfound_password
INSTAHYRE_EMAIL=
INSTAHYRE_PASSWORD=your_instahyre_password

# ── Cold Email ─────────────────────────────────────────────────────────────────
COLD_EMAIL_DAILY_LIMIT=40
COLD_EMAIL_DELAY_SECONDS=120
COLD_EMAIL_MAX_PER_DOMAIN=10
EMAIL_SENDER_NAME=Gaurav Sonkar

# ── Database & Storage ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/autoapply.db
RESUMES_DIR=resumes
SCREENSHOTS_DIR=screenshots

# ── LLM Models ─────────────────────────────────────────────────────────────────
GROQ_MODEL_HEAVY=llama-3.3-70b-versatile

# ── Resume ─────────────────────────────────────────────────────────────────────
RESUME_TEMPLATE_PATH=templates/resume_template.tex
MASTER_PROFILE_PATH=master_profile.json
ATS_MIN_SCORE=85
RESUME_MAX_RETRIES=3

# ── FastAPI Server ─────────────────────────────────────────────────────────────
# IMPORTANT: Keep API_HOST as 127.0.0.1 — this is a local-only tool.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173

# ── Authentication ─────────────────────────────────────────────────────────────
# Bootstrap the first admin and set secret key with: python scripts/set_password.py
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_HOURS=12

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Resume storage ───────────────────────────────────────────────────────────────────
# local: generated resumes stay in RESUMES_DIR (needs nothing).
# s3:    each generated resume is also uploaded, and the download button becomes
#        a presigned S3 link valid for S3_PRESIGN_TTL_SECONDS.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_PREFIX=autoapply
S3_PRESIGN_TTL_SECONDS=900
# Leave blank to use boto3's default credential chain (env, ~/.aws, IAM role).
# The IAM user only needs s3:PutObject and s3:GetObject on the bucket/prefix.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
